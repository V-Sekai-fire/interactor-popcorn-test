{
  "name": "Popcorn Elixir Dev Container (Linux)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/popcorn-test",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/popcorn-test,type=bind,consistency=cached",
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined"
  ],
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker-host.sock,type=bind"
  ],
  "forwardPorts": [4000, 8080],
  "postCreateCommand": "mise install && mix deps.get",
  "customizations": {
    "vscode": {
      "extensions": [
        "elixir-ls.elixir-ls",
        "mjmayer.elixir",
        "ms-vscode.vscode-json",
        "github.copilot"
      ],
      "settings": {
        "elixirLS.dialyzerEnabled": true,
        "elixirLS.mixTasks": ["popcorn.cook", "popcorn.build_runtime"]
      }
    }
  },
  "remoteUser": "root"
}
